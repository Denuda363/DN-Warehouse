{
  "entities": {
    "AppData": {
      "title": "AppData",
      "description": "Singleton storing the entire application state (legacy architecture)",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "categories": { "type": "array" },
        "units": { "type": "array" },
        "suppliers": { "type": "array" },
        "staffs": { "type": "array" },
        "items": { "type": "array" },
        "transactions": { "type": "array" },
        "purchaseInvoices": { "type": "array" },
        "theme": { "type": "string" },
        "colorTheme": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/appData/main": {
      "schema": "AppData",
      "description": "The central repository for the entire Gudang application."
    }
  }
}
