rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /appData/main {
      // Allow any anonymous user to read/write the central JSON document 
      // matching the previous localstorage behavior where the custom Login.tsx handles UI Auth.
      allow read, write: if true;
    }
  }
}
